DATABASE_URL=postgres://isppr:isppr@localhost:5433/isppr?sslmode=disable
PORT=8090
GOTENBERG_URL=http://localhost:3001
# Comma-separated pool endpoints override GOTENBERG_URL when set.
#GOTENBERG_ENDPOINTS=http://gotenberg-1:3000,http://gotenberg-2:3000
RENDER_TIMEOUT_SECONDS=30
CORS_ORIGIN=http://localhost:3100

# Artifact store: "local" (STORAGE_LOCAL_DIR, streamed downloads) or
# "s3" (MinIO/S3, presigned download URLs). Compose dev runs s3.
STORAGE_BACKEND=s3
STORAGE_LOCAL_DIR=data/docs
S3_ENDPOINT=http://localhost:9100
# Where presigned URLs are minted — must resolve for the API *caller*,
# not the container. Defaults to S3_ENDPOINT.
#S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_BUCKET=isppr-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_URL_TTL_MINUTES=15
# Upload single-document packages as raw .pdf (output_type PDF) instead
# of wrapping in a ZIP.
#SINGLE_DOC_SKIP_ZIP=0

# Webhook callbacks to customers.webhook_url on request completion/failure:
# POST with X-ISPPr-Signature: sha256=<hmac(secret, body)>, bounded
# retries with exponential backoff, delivery log on the request row.
WEBHOOK_SECRET=isppr_dev_webhook
WEBHOOK_MAX_ATTEMPTS=5

MAX_DOCS_PER_PACKAGE=25

# Hardening (MPE-45): request-body cap on POST /generate (bytes, 413 past
# it), per-client token-bucket rate limit (429 past it; burst = 2x rate),
# and a global ceiling on one job's pipeline run before it fails as
# transient and is requeued.
#MAX_BODY_BYTES=4194304
#RATE_LIMIT_RPS=20
#JOB_TIMEOUT_SECONDS=120

NEXT_PUBLIC_API_URL=http://localhost:8090

# Observability (MPE-44): all empty = exporters off (unchanged behavior).
# Traces → Jaeger via OTLP/gRPC; structured logs → Seq via OTLP/HTTP.
#OTEL_SERVICE_NAME=isppr
#OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
#OTEL_LOGS_ENDPOINT=http://seq:5341/ingest/otlp
